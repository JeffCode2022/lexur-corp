  },
  "contrastPairs": [
    ["text.primary", "bg.canvas", 4.5],
    ["text.primary", "bg.surface3", 4.5],
    ["text.secondary", "bg.canvas", 4.5],
    ["text.secondary", "bg.surface2", 4.5],
    ["text.tertiary", "bg.canvas", 4.5],
    ["text.tertiary", "bg.surface2", 4.5],
    ["text.inverse", "bg.inverse", 4.5],
    ["accent.default", "bg.canvas", 3.0],
    ["text.onAccent", "accent.default", 4.5],
    ["accent.text", "bg.canvas", 4.5],
    ["accent.text", "bg.surface2", 4.5],
    ["accent.text", "accent.subtle", 4.5],
    ["status.success", "bg.canvas", 4.5],
    ["status.warning", "bg.canvas", 4.5],
    ["status.danger", "bg.canvas", 4.5],
    ["status.success", "status.successSubtle", 4.5],
    ["status.warning", "status.warningSubtle", 4.5],
    ["status.danger", "status.dangerSubtle", 4.5],
    ["border.control", "bg.canvas", 3.0],
    ["border.control", "bg.surface1", 3.0],
    ["focus.ring", "bg.canvas", 3.0]
  ],
  "tailwindNames": {
    "bg.canvas": "canvas",
    "bg.surface1": "surface-1",
    "bg.surface2": "surface-2",
    "bg.surface3": "surface-3",
    "bg.inverse": "inverse",
    "border.subtle": "line-subtle",
    "border.default": "line",
    "border.strong": "line-strong",
    "border.control": "line-control",
    "text.primary": "fg",
    "text.secondary": "fg-muted",
    "text.tertiary": "fg-subtle",
    "text.disabled": "fg-disabled",
    "text.inverse": "fg-inverse",
    "text.onAccent": "on-accent",
    "accent.default": "accent",
    "accent.hover": "accent-hover",
    "accent.pressed": "accent-pressed",
    "accent.subtle": "accent-subtle",
    "accent.text": "accent-fg",
    "status.success": "success",
    "status.successSubtle": "success-subtle",
    "status.warning": "warning",
    "status.warningSubtle": "warning-subtle",
    "status.danger": "danger",
    "status.dangerSubtle": "danger-subtle",
    "focus.ring": "focus",
    "overlay.scrim": "scrim"
  },
  "font": {
    "sans": "Geist",
    "sansFallback": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "Geist Mono",
    "monoFallback": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
    "appleNative": "SF Pro (system font)"
  },
  "type": {
    "displayXl": { "size": 72, "line": 76, "tracking": -0.04, "weight": 600 },
    "display":   { "size": 56, "line": 60, "tracking": -0.03, "weight": 600 },
    "h1":        { "size": 40, "line": 44, "tracking": -0.025, "weight": 600 },
    "h2":        { "size": 32, "line": 38, "tracking": -0.02, "weight": 600 },
    "h3":        { "size": 24, "line": 30, "tracking": -0.015, "weight": 600 },
    "h4":        { "size": 20, "line": 26, "tracking": -0.01, "weight": 600 },
    "bodyLg":    { "size": 17, "line": 26, "tracking": 0, "weight": 400 },
    "body":      { "size": 15, "line": 22, "tracking": 0, "weight": 400 },
    "bodySm":    { "size": 13, "line": 18, "tracking": 0, "weight": 400 },
    "label":     { "size": 14, "line": 20, "tracking": 0, "weight": 500 },
    "caption":   { "size": 12, "line": 16, "tracking": 0.01, "weight": 500 },
    "overline":  { "size": 11, "line": 14, "tracking": 0.08, "weight": 600 },
    "metric":    { "size": 48, "line": 52, "tracking": -0.02, "weight": 500 }
  },
  "space": { "s0": 0, "s2": 2, "s4": 4, "s8": 8, "s12": 12, "s16": 16, "s20": 20, "s24": 24, "s32": 32, "s40": 40, "s48": 48, "s64": 64, "s80": 80, "s96": 96, "s128": 128 },
  "radius": { "none": 0, "xs": 4, "sm": 6, "md": 10, "lg": 14, "xl": 20, "full": 9999 },
  "control": { "sm": 32, "md": 40, "lg": 48, "touchMinIos": 44, "touchMinAndroid": 48 },
  "layout": { "sidebar": 248, "sidebarCollapsed": 64, "header": 56, "contentMax": 1200, "readingMax": 680, "gutterMobile": 16, "gutterDesktop": 32 },
  "breakpoint": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "xxl": 1536 },
  "motion": {
    "duration": { "instant": 80, "fast": 150, "base": 220, "slow": 320, "deliberate": 480 },
    "easing": {
      "standard": [0.2, 0.0, 0.0, 1.0],
      "enter": [0.05, 0.7, 0.1, 1.0],
      "exit": [0.3, 0.0, 0.8, 0.15]
    },
    "spring": { "dampingRatio": 0.86, "responseSeconds": 0.35 }
  },
  "z": { "base": 0, "sticky": 100, "dropdown": 200, "overlay": 300, "modal": 400, "toast": 500, "tooltip": 600 }
}
